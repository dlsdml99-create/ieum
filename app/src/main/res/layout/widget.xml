<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="4dp" android:paddingBottom="6dp"
        android:textSize="13sp" android:textStyle="bold" android:textColor="#F2F2EC" android:text="이음" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/w_listen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_btn" android:gravity="center" android:minHeight="48dp"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#16181B" android:text="듣기" />
        <TextView android:id="@+id/w_speak" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:background="@drawable/widget_btn" android:gravity="center" android:minHeight="48dp"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#16181B" android:text="말하기" />
        <TextView android:id="@+id/w_see" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:background="@drawable/widget_btn" android:gravity="center" android:minHeight="48dp"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#16181B" android:text="보기" />
    </LinearLayout>
</LinearLayout>
